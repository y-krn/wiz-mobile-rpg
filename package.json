{
  "name": "wiz-mobile-rpg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "generate:icons": "node scripts/generate_icons.js",
    "test": "npm run test:unit:full && npm run test:browser",
    "test:unit": "node scratch/tests/run_tests.js",
    "test:unit:fast": "FAST=1 node scratch/tests/run_tests.js",
    "test:unit:full": "FULL_TEST=1 node scratch/tests/run_tests.js",
    "simulation": "node scratch/simulations/sim_depth_material_ev.js",
    "measure:balance": "node scratch/measurements/measure_balance.js",
    "compare:balance": "node scratch/measurements/compare_balance.js",
    "test:browser": "npm run test:browser:smoke",
    "test:browser:smoke": "node scripts/dependency-preflight.js && playwright test --grep @smoke",
    "test:browser:parallel": "node scripts/dependency-preflight.js && PLAYWRIGHT_WORKERS=2 playwright test --grep @smoke",
    "test:browser:preflight": "node scripts/dependency-preflight.js && node scripts/playwright-preflight.js",
    "test:browser:e2e": "node scripts/dependency-preflight.js && playwright test --grep @e2e",
    "test:browser:visual": "node scripts/dependency-preflight.js && playwright test --grep @visual",
    "test:browser:full": "node scripts/dependency-preflight.js && playwright test",
    "lint:css": "stylelint \"src/style.css\" \"src/styles/**/*.css\"",
    "lint:docs": "node scripts/check_doc_paths.js",
    "lint:tests": "node scripts/check_playwright_test_names.js && node scripts/check_playwright_test_names.test.js",
    "lint:markdown": "node scripts/check_markdown_links.js",
    "lint:workflow": "node scripts/check_workflow_yaml.js",
    "lint": "npm run lint:css && npm run lint:docs && npm run lint:tests && npm run lint:markdown && npm run lint:workflow && eslint . --cache"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@sentry/vite-plugin": "^5.3.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.12",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@sentry/browser": "^10.63.0",
    "posthog-js": "^1.418.10"
  }
}
