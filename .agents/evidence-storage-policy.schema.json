{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "newTrackedRawGeneratedJsonMaxBytes", "artifactPolicy", "classificationRules", "exceptions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "newTrackedRawGeneratedJsonMaxBytes": {"const": 1048576},
    "artifactPolicy": {
      "type": "object",
      "required": ["defaultRetentionDays", "durableOutputs", "rawUpload", "provenanceFields", "forbiddenContent"],
      "properties": {
        "defaultRetentionDays": {"const": 14},
        "rawUpload": {"const": "failure-or-explicit-debug"}
      }
    },
    "classificationRules": {"type": "array", "minItems": 1},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "classification", "rationale", "owner", "maximumSize", "mode", "review"],
        "properties": {
          "path": {"type": "string", "pattern": "^evidence/.+"},
          "classification": {"enum": ["raw-generated-json", "decision/provenance", "fixture", "protocol", "canonical-baseline", "visual-review"]},
          "rationale": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "maximumSize": {"type": "integer", "exclusiveMinimum": 0},
          "mode": {"enum": ["grandfathered", "allow-new"]},
          "review": {
            "type": "object",
            "required": ["reviewedBy", "reviewedAt", "expiresAt"]
          },
          "base": {
            "type": "object",
            "required": ["tree", "blob", "size"]
          }
        }
      }
    }
  }
}
