{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-brief.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/wt-cleanup.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-write.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-guard.sh pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-guard.sh post"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(codex exec:*)",
      "Bash(scripts/codex-run.sh:*)",
      "Bash(npm run *)",
      "Bash(npx playwright *)",
      "Bash(npx eslint *)",
      "Bash(node --check *)",
      "Bash(node scratch/*)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rg *)"
    ]
  }
}
